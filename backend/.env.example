# Banco principal inicial. Uma seleção feita na interface tem precedência
# após migração validada e reinício do backend.
DATABASE_URL=sqlite+aiosqlite:///./network_monitor.db
REDIS_URL=redis://localhost:6379/0

SNMP_COMMUNITY=public
SNMP_VERSION=2c

INTERVAL_CRITICAL=5
INTERVAL_NORMAL=30
INTERVAL_SERVICES=10
FAILURES_TO_DOWN=3
SUCCESSES_TO_UP=2
PACKET_LOSS_THRESHOLD=50.0

# Mantenha esta chave estável: ela protege passwords, tokens e a seleção do banco.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=true

# Notificações opcionais
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Network Monitor <alerts@example.com>
ALERT_EMAIL_RECIPIENTS=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
