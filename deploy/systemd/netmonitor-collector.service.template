[Unit]
Description=NetMonitor collector replica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@INSTALL_DIR@/backend
# Create one distinct file per collector host, for example
# /etc/netmonitor/collector-a.env with COLLECTOR_ID=collector-a.
EnvironmentFile=/etc/netmonitor/collector.env
Environment=COLLECTOR_ENABLED=true
ExecStart=@INSTALL_DIR@/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 5555
Restart=always
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
