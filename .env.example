# Copy this file to .env and replace every required placeholder before startup.
POSTGRES_DB=network_monitor
POSTGRES_USER=nm_user
POSTGRES_PASSWORD=replace-with-a-strong-password

# Application
# Keep this key stable: it protects credentials, tokens, and the database selection.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
AUTH_DISABLED=false
AUTH_SESSION_MINUTES=480
PASSWORD_SCRYPT_N=16384
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
BOOTSTRAP_TOKEN=replace-with-a-single-use-random-bootstrap-token
CORS_ALLOWED_ORIGINS=http://localhost:3389,http://localhost:3000
PASSWORD_RESET_MINUTES=30

# Database connection pool (used for MySQL, PostgreSQL, SQL Server and Oracle;
# SQLite manages its own local connection behaviour).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=20
DATABASE_POOL_RECYCLE_SECONDS=1800

# SNMP
SNMP_COMMUNITY=
SNMP_VERSION=2c

# Monitoring (seconds)
INTERVAL_CRITICAL=5
INTERVAL_NORMAL=30
INTERVAL_SERVICES=10
# Collector capacity ceilings. Tune only after observing System Health under
# representative load; they prevent one cycle from creating unbounded local
# subprocesses or database pressure.
MONITORING_PROBE_CONCURRENCY=100
MONITORING_PROBE_BATCH_SIZE=1000
ICMP_PROCESS_CONCURRENCY=32
SNMP_TRANSPORT_CONCURRENCY=16
NOTIFICATION_CONCURRENCY=4
NOTIFICATION_CONNECT_TIMEOUT_SECONDS=10
NOTIFICATION_FAILURE_LOG_COOLDOWN_SECONDS=300
SHUTDOWN_GRACE_SECONDS=8
# Maximum rows removed from each detailed-history table during one hourly
# maintenance run. The same retention_days setting controls their age.
RETENTION_CLEANUP_BATCH_SIZE=5000
RAW_METRIC_RETENTION_DAYS=7
# Give every collector replica a distinct stable identifier. Set false on API
# replicas that must not run monitoring work.
COLLECTOR_ID=collector-01
COLLECTOR_ENABLED=true
COLLECTOR_LEASE_SECONDS=45
COLLECTOR_LEASE_RETRY_ATTEMPTS=3
COLLECTOR_LEASE_RETRY_DELAY_MS=75
# Set finite claim/batch values on each collector in a multi-node deployment
# so the first node cannot own every due check. Zero means no separate limit.
COLLECTOR_DEVICE_CLAIM_LIMIT=0
REMOTE_MONITORING_CONCURRENCY=10
REMOTE_MONITORING_BATCH_SIZE=0
FAILURES_TO_DOWN=3
SUCCESSES_TO_UP=2
PACKET_LOSS_THRESHOLD=50.0

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Network Monitor <alerts@example.com>
ALERT_EMAIL_RECIPIENTS=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp HTTP API is configured in Settings > Notifications.
# Empty uses the backend host timezone. Example: Africa/Maputo or Africa/Blantyre.
NOTIFICATION_TIMEZONE=
