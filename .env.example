# Copy this file to .env and replace every required placeholder before startup.
POSTGRES_DB=network_monitor
POSTGRES_USER=nm_user
POSTGRES_PASSWORD=replace-with-a-strong-password

# Application
# Keep this key stable: it protects credentials, tokens, and the database selection.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
AUTH_DISABLED=false
AUTH_SESSION_MINUTES=480
PASSWORD_SCRYPT_N=16384
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
BOOTSTRAP_TOKEN=replace-with-a-single-use-random-bootstrap-token
CORS_ALLOWED_ORIGINS=http://localhost:3389,http://localhost:3000
PASSWORD_RESET_MINUTES=30

# SNMP
SNMP_COMMUNITY=
SNMP_VERSION=2c

# Monitoring (seconds)
INTERVAL_CRITICAL=5
INTERVAL_NORMAL=30
INTERVAL_SERVICES=10
FAILURES_TO_DOWN=3
SUCCESSES_TO_UP=2
PACKET_LOSS_THRESHOLD=50.0

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Network Monitor <alerts@example.com>
ALERT_EMAIL_RECIPIENTS=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional whatsapp-web.js bridge. Generate a distinct random token and do not
# publish the bridge port outside the trusted host or container network.
WHATSAPP_WEB_SERVICE_URL=http://whatsapp-web:3010
WHATSAPP_WEB_SERVICE_TOKEN=replace-with-a-long-random-internal-token
WHATSAPP_PRINT_QR_TERMINAL=false
